<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <header class="topo">
    <div class="container topo-conteudo">
      <div>
        <span class="etiqueta">PROJETO APLICAÇÃO WEB PRÁTICA</span>
        <h1>Cadastro de Produtos</h1>
        <p>Aplicação com Node.js, Express, EJS e MySQL.</p>
      </div>
      <span class="marcador">Controle de estoque</span>
    </div>
  </header>

  <main class="container conteudo">
    <% if (mensagem) { %>
      <div class="alerta sucesso" role="status"><%= mensagem %></div>
    <% } %>
    <% if (erroFormulario) { %>
      <div class="alerta erro" role="alert"><%= erroFormulario %></div>
    <% } %>

    <section class="painel" aria-labelledby="titulo-cadastro">
      <div class="titulo-secao">
        <div>
          <h2 id="titulo-cadastro">Novo produto</h2>
          <p>Preencha os campos para cadastrar um item no banco de dados.</p>
        </div>
      </div>

      <form action="/itens" method="POST" class="formulario">
        <div class="campo">
          <label for="nome">Nome do produto</label>
          <input id="nome" name="nome" type="text" maxlength="100" required
            placeholder="Ex.: Mouse Gamer" value="<%= dados.nome || '' %>">
        </div>

        <div class="campo">
          <label for="categoria">Categoria</label>
          <input id="categoria" name="categoria" type="text" maxlength="80" required
            placeholder="Ex.: Periféricos" value="<%= dados.categoria || '' %>">
        </div>

        <div class="campo">
          <label for="preco">Preço (R$)</label>
          <input id="preco" name="preco" type="number" min="0" max="99999999.99" step="0.01" required
            placeholder="Ex.: 99.90" value="<%= dados.preco ?? '' %>">
        </div>

        <div class="campo">
          <label for="quantidade">Quantidade em estoque</label>
          <input id="quantidade" name="quantidade" type="number" min="0" step="1" required
            placeholder="Ex.: 10" value="<%= dados.quantidade ?? '' %>">
        </div>

        <div class="campo campo-largo">
          <label for="descricao">Descrição</label>
          <textarea id="descricao" name="descricao" maxlength="1000" rows="3" required
            placeholder="Descreva o produto"><%= dados.descricao || '' %></textarea>
        </div>

        <div class="acoes">
          <button type="submit">Cadastrar produto</button>
          <span>Todos os campos são obrigatórios.</span>
        </div>
      </form>
    </section>

    <section class="painel" aria-labelledby="titulo-lista">
      <div class="titulo-secao titulo-com-contador">
        <div>
          <h2 id="titulo-lista">Produtos cadastrados</h2>
          <p>Itens salvos no MySQL, atualizados quando a página é carregada.</p>
        </div>
        <span class="contador"><%= produtos.length %> produto(s)</span>
      </div>

      <% if (produtos.length === 0) { %>
        <p class="vazio">Nenhum produto cadastrado ainda. Use o formulário acima.</p>
      <% } else { %>
        <div class="tabela-rolagem">
          <table>
            <thead>
              <tr>
                <th scope="col">ID</th>
                <th scope="col">Nome</th>
                <th scope="col">Categoria</th>
                <th scope="col">Preço</th>
                <th scope="col">Quantidade</th>
                <th scope="col">Descrição</th>
              </tr>
            </thead>
            <tbody>
              <% produtos.forEach(produto => { %>
                <tr>
                  <td><%= produto.id %></td>
                  <td class="nome-produto"><%= produto.nome %></td>
                  <td><%= produto.categoria %></td>
                  <td>R$ <%= Number(produto.preco).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                  <td><%= produto.quantidade %></td>
                  <td><%= produto.descricao %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>
  <footer class="rodape">Projeto acadêmico • Express + EJS + MySQL</footer>
</body>
</html>
